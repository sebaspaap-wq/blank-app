{
  "name": "CAVÁ — Next.js",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "src/app/page.tsx"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["bradlc.vscode-tailwindcss", "dbaeumer.vscode-eslint"]
    }
  },
  "updateContentCommand": "npm install",
  "postAttachCommand": {
    "server": "npm run dev"
  },
  "portsAttributes": {
    "3000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [3000]
}
