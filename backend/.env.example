# ---------------------------------------------------------------------------
# WOSZ backend — voorbeeldconfiguratie
#
# Kopieer dit bestand naar .env en vul je eigen waarden in.
# Zet hier NOOIT echte secrets in en commit .env NOOIT naar git.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Standaard SQLite: een bestand naast de code, niets te installeren. Prima om
# het systeem lokaal te draaien en te gebruiken.
WOSZ_DATABASE_URL=sqlite+aiosqlite:///./wosz.db

# Voor productie: PostgreSQL. Haal het commentaar weg en vul je eigen gegevens in.
# WOSZ_DATABASE_URL=postgresql+asyncpg://wosz:wachtwoord@localhost:5432/wosz

# --- Anthropic API (agent-beslissingen) -------------------------------------
# LEEG LATEN = GRATIS. Zonder key draaien alle agents in regelmodus: ze werken
# volledig, maar beslissen op vaste regels in plaats van met Claude. Je betaalt
# dan niets en er gaat geen enkele aanvraag het internet op.
#
# Vul je pas een key in, dan gebruikt Claude:
#   - Matching  : kiezen tussen even geschikte kandidaten
#   - Support   : bepalen welk kennisbankantwoord bij een vraag hoort
#   - Marketing : de tekst van een social post schrijven
# Al het andere (tiers, events, logging, facturen, kalender) werkt hetzelfde.
ANTHROPIC_API_KEY=
WOSZ_ANTHROPIC_MODEL=claude-opus-5
WOSZ_ANTHROPIC_EFFORT=medium

# --- Escalatie / tiers ------------------------------------------------------
# Aantal uren dat Sebas heeft om in te grijpen bij een tier 2-beslissing
# voordat de agent alsnog uitvoert.
WOSZ_TIER2_DEADLINE_UREN=24

# --- Event-bus --------------------------------------------------------------
# Polling-interval (seconden) van de worker die agent_events afhandelt.
WOSZ_EVENT_POLL_SECONDEN=5
WOSZ_EVENT_MAX_POGINGEN=3

# --- API --------------------------------------------------------------------
# Adressen waarvandaan het dashboard de API mag benaderen.
#
# Het dashboard draait op poort 8090 (de backend zelf op 8000), dus die poort
# moet hier staan. Klopt dit niet, dan laadt de pagina wel maar blijft hij leeg:
# de browser blokkeert de gegevens dan stilletjes.
WOSZ_CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# --- Uitbetalingen ----------------------------------------------------------
# LET OP: hier staan met opzet GEEN betaal- of bankgegevens.
# Uitbetalen gebeurt handmatig door Sebas buiten dit systeem om; de backend
# levert alleen een exportbestand na goedkeuring in het dashboard.
# De agents kunnen deze instelling niet lezen (zie app/payouts/README.md).
WOSZ_UITBETALING_EXPORT_MAP=./exports
